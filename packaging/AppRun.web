#!/bin/sh
# AppRun de la AppImage web del RU5600 Reader.
# Ventana nativa con pywebview (WebKit2 del sistema). Si no está disponible,
# cae a navegador. --browser fuerza el modo navegador, --no-browser solo servidor.
HERE="$(dirname "$(readlink -f "$0")")"
APP_DIR="$HERE/usr/opt/ru5600-web"

# Python: bundled (self-contained) first, system fallback
if [ -x "$HERE/usr/lib/python3.12/bin/python3" ]; then
    PYTHON="$HERE/usr/lib/python3.12/bin/python3"
else
    PYTHON="python3"
fi
export LD_LIBRARY_PATH="$APP_DIR/vendor:${LD_LIBRARY_PATH:-}"
export PYTHONPATH="$APP_DIR/pylibs:${PYTHONPATH:-}"
# gi/WebKit2 (si está en el sistema) para la ventana nativa
for sp in /usr/lib/python3/dist-packages /usr/lib/python3/site-packages /usr/local/lib/python3*/dist-packages; do
    [ -d "$sp" ] && export PYTHONPATH="$PYTHONPATH:$sp"
done

if [ -z "$RU5600_EXPORT_DIR" ]; then
    export RU5600_EXPORT_DIR="$(dirname "$(readlink -f "${APPIMAGE:-$0}")")/EXPORTES"
fi
if [ -z "$RU5600_DATA_DIR" ]; then
    export RU5600_DATA_DIR="$(dirname "$(readlink -f "${APPIMAGE:-$0}")")/DATA"
fi
mkdir -p "$RU5600_EXPORT_DIR" "$RU5600_DATA_DIR" 2>/dev/null

# pywebview usa WebKit2 del sistema (gir1.2-webkit2-4.1). Si está, ventana
# nativa; si no, navegador.
MODE="--native"
for arg in "$@"; do
    case "$arg" in
        --browser) MODE="" ;;
        --no-browser) MODE="--no-browser" ;;
    esac
done

if [ -n "$MODE" ] && ! $PYTHON -c 'import webview, gi; gi.require_version("WebKit2","4.1")' >/dev/null 2>&1; then
    echo "RU5600 web: pywebview/WebKit2 no disponible, modo navegador." >&2
    MODE=""
fi

echo "RU5600 web corriendo en http://127.0.0.1:${RU5600_PORT:-8000}  (Ctrl+C para cortar)"
exec $PYTHON "$APP_DIR/app.py" $MODE $@
